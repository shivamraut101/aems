# dependencies
node_modules/
.pnpm-store/

# build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# electron-builder's buildResources — icons and macOS entitlements are source, not
# output, and the blanket "build/" above would drop them from the repo.
!apps/desktop-agent/build/
!apps/desktop-agent/build/**

# electron-builder installers
apps/desktop-agent/release/

# turbo
.turbo/

# env
.env
.env.local
.env.*.local

# expo
apps/android-agent/.expo/
apps/android-agent/android/
apps/android-agent/ios/

# supabase
supabase/.branches/
supabase/.temp/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# coverage
coverage/

# Agent scratch space.
#
# A verification agent left a 53 MB copy of apps/admin-dashboard at apps/_verify375
# and a pile of scraped HTML at .tmp-verify — including a cookie.txt holding a live
# session cookie. Both were untracked, so `git add -A` would have pushed all of it.
# `apps/_*` rather than the one name: the next agent will pick a different number.
apps/_*/
.tmp-*/
