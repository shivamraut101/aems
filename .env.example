# AEMS — environment template
#
# Copy to `.env` at the repo root and fill in. One file at the root serves the API,
# the dashboard, the agents and the Edge Functions: `apps/api/src/env.ts` walks up
# from its own directory, so a package-local `.env` overrides this one where it
# exists. `.env` is gitignored and must stay that way — it holds the service-role
# key, which bypasses Row Level Security entirely.
#
# Ask the project lead for real values. Nothing here is a working credential.

# -- Supabase -----------------------------------------------------------------
# Dashboard -> Project Settings -> API

SUPABASE_URL=https://your-project.supabase.co

# Safe in a browser. RLS is what protects data behind it.
SUPABASE_ANON_KEY=

# NEVER ships to a client and never gets committed. Bypasses RLS, so on the API
# path the route guards are the only authorization boundary that exists.
SUPABASE_SERVICE_ROLE_KEY=

# -- API ----------------------------------------------------------------------

# Signs device tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every enrolled device, which is the point — production
# and local development must not share a value.
DEVICE_TOKEN_SECRET=

API_PORT=3001
API_HOST=0.0.0.0

# Origin allowed to call the API. The deployed dashboard's URL in production.
CORS_ORIGIN=http://localhost:3000

# development | test | production. Not the branch name.
NODE_ENV=development

# -- Email (Resend) -----------------------------------------------------------
#
# The ONLY variable needed to turn mail on. Optional by design: an unconfigured
# mailer must not stop the API booting, because a missing key taking down
# monitoring for a whole company over a notification is the worse failure.
# Absent, every message is composed, addressed and logged rather than sent, as
#   [email] not sent - RESEND_API_KEY is unset
# so the templates are reviewable before a key exists. To read them as they will
# arrive:  node scripts/email-preview.mjs
RESEND_API_KEY=

# Must be on a domain VERIFIED in Resend, or every send is refused with 403.
# That DNS step is the one part of this no environment variable can fix.
EMAIL_FROM="AEMS <noreply@primexmeta.com>"

# Where a link inside an email points - the dashboard's public origin, not the
# API's. Defaults to the first entry in CORS_ORIGIN, which is correct in every
# deployment so far; set it only when the two genuinely differ.
DASHBOARD_URL=

# -- Admin dashboard (Next.js) ------------------------------------------------
#
# THESE DO NOT BELONG IN THIS FILE EITHER. Next.js reads `.env` and `.env.local`
# from the app's own directory, not from the workspace root — so set them in
# `apps/admin-dashboard/.env.local`, and note that `.env.local` beats every other
# env file Next loads. Editing the root file changes nothing and looks like it
# should, which has cost real debugging time twice now.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time. Changing one
# needs the dev server restarted, and nothing secret may go in one.
#
#   NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   NEXT_PUBLIC_API_URL=http://localhost:3001

# -- Agents -------------------------------------------------------------------

# Desktop agent (Electron)
AEMS_API_URL=http://localhost:3001

# Android agent (Expo).
#
# THESE TWO DO NOT BELONG IN THIS FILE. Expo reads `.env` from the app's own
# directory, not from the workspace root, and `metro.config.js` adds no loader
# that would change that — so set them in `apps/android-agent/.env` instead.
# Listed here only so the full set of variables is discoverable in one place.
#
# EXPO_PUBLIC_* is inlined into the JS bundle by Metro AT BUILD TIME. It is not
# read at runtime, so an APK is permanently pointed at whatever it was built
# with, and nothing secret may go in one.
#
#   EXPO_PUBLIC_AEMS_API_URL=https://your-api.onrender.com
#
# For local development: `localhost` inside an emulator means the emulator, not
# your machine. Use 10.0.2.2 for the Android emulator (this is the default when
# the variable is unset), or the host's LAN IP for a physical device.
#
#   EXPO_PUBLIC_AEMS_MOCK_API=1
#
# Runs the app against in-memory fixtures with no API at all. Leave it UNSET for
# any build anyone else will install — an APK built with it on looks like it
# works and talks to nothing.
