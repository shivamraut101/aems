# ---------------------------------------------------------------------------
# Supabase
#
# Project settings -> API. The anon key is public; the service role key is not.
# ---------------------------------------------------------------------------

SUPABASE_PROJECT_ID="dayyrqcfktwwnkttlres"
SUPABASE_URL="https://dayyrqcfktwwnkttlres.supabase.co"
SUPABASE_ANON_KEY=""

# Bypasses RLS. Server-side only — apps/api and supabase/functions.
# Never expose this to the dashboard bundle or ship it inside an agent binary.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# apps/admin-dashboard
#
# NEXT_PUBLIC_* is inlined into the browser bundle. Only ever the anon key here.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://dayyrqcfktwwnkttlres.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------

API_PORT=3001
API_HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:3000"

# Signs the long-lived device tokens agents present on every request. Unrelated
# to Supabase Auth, which handles human sessions.
DEVICE_TOKEN_SECRET="change-me"

# ---------------------------------------------------------------------------
# AI provider (supabase/functions/ai-summary)
#
# Set AI_PROVIDER to whichever key you filled in.
# ---------------------------------------------------------------------------

AI_PROVIDER="claude"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------

AEMS_API_URL="http://localhost:3001"

# apps/android-agent — read via `process.env.EXPO_PUBLIC_*`, inlined into the JS
# bundle by Metro at build time. 10.0.2.2 is the Android emulator's alias for the
# host machine; a physical device needs the host's LAN IP instead.
EXPO_PUBLIC_AEMS_API_URL="http://10.0.2.2:3001"
