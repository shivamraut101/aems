# AEMS Android agent — copy to `.env` in THIS directory (apps/android-agent/.env).
#
# Expo reads .env from the app directory, not the workspace root. The root
# .env serves the API, the dashboard and the desktop agent; it does not reach here.
#
# EXPO_PUBLIC_* is inlined into the JS bundle by Metro at BUILD TIME, not read at
# runtime. An APK is permanently pointed at whatever this said when it was built,
# and anything put here ships inside the APK — so no secrets, ever.

# Where the agent sends everything. Must be https for a release build:
# Android blocks cleartext HTTP by default.
EXPO_PUBLIC_AEMS_API_URL=https://aems-kbb9.onrender.com

# Leave UNSET. Set to 1 only to click through the UI with no backend at all —
# login and consent run their real logic against in-memory fixtures. An APK built
# with this on looks like it works and talks to nothing.
EXPO_PUBLIC_AEMS_MOCK_API=
