# AEMS admin dashboard — copy to `.env.local` in THIS directory.
#
# Next.js reads env files from the app directory, never from the workspace root.
# The root `.env` serves the API, the desktop agent and the Edge Functions; it does
# not reach here. `.env.local` also beats `.env`, so if both exist this one wins.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time, not read at
# runtime: changing any of these needs the dev server restarted, and anything put
# here ships to every visitor — so no secrets, ever.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Safe in a browser. RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the dashboard sends business operations. Realtime goes to Supabase direct.
# Local development: http://localhost:3001 with `pnpm --filter @aems/api dev` running.
NEXT_PUBLIC_API_URL=https://aems-kbb9.onrender.com
